{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:scoring": "esbuild src/lib/zero3-scoring.test.ts --bundle --platform=node --format=esm --outfile=/tmp/zero3-scoring.test.mjs && node --test /tmp/zero3-scoring.test.mjs",
    "test:auth-session": "esbuild src/lib/auth-session.test.ts --bundle --platform=node --format=esm --outfile=/tmp/zero3-auth-session.test.mjs && node --test /tmp/zero3-auth-session.test.mjs",
    "test:worker-logger": "esbuild src/lib/worker-logger.test.ts --bundle --platform=node --format=esm --outfile=/tmp/zero3-worker-logger.test.mjs && node --test /tmp/zero3-worker-logger.test.mjs",
    "test:db-context": "esbuild src/lib/zero3-db-context.test.ts --bundle --platform=node --format=esm --external:pg --external:drizzle-orm --external:drizzle-orm/* --outfile=/tmp/zero3-db-context.test.mjs && node --test /tmp/zero3-db-context.test.mjs",
    "test:api-errors": "esbuild src/lib/api-errors.test.ts --bundle --platform=node --format=esm --outfile=/tmp/zero3-api-errors.test.mjs && node --test /tmp/zero3-api-errors.test.mjs",
    "seed:demo": "export NODE_ENV=development; set -e; out=../../lib/db/seed-demo.build.mjs; trap 'rm -f \"$out\"' EXIT; esbuild scripts/seed-demo.mjs --bundle --platform=node --format=esm --external:pg --external:drizzle-orm --external:drizzle-orm/* --outfile=\"$out\" && node \"$out\""
  },
  "dependencies": {
    "@clerk/express": "^2.1.86",
    "@clerk/shared": "^4.43.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
